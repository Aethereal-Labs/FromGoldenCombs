<Project>
  <!--
    Machine-specific paths live in Directory.Build.props.user (gitignored).
    Copy Directory.Build.props.user.example to Directory.Build.props.user and adjust the paths.
    Fallbacks: the VINTAGE_STORY / VINTAGE_STORY_DATA environment variables, then the default
    Vintage Story install location. No fallback is provided for the data path on purpose: a
    launch profile must never point at a real game data folder by accident.
  -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.props.user" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.props.user')" />

  <PropertyGroup>
    <VintageStoryPath Condition="'$(VintageStoryPath)' == '' and '$(VINTAGE_STORY)' != ''">$(VINTAGE_STORY)</VintageStoryPath>
    <VintageStoryPath Condition="'$(VintageStoryPath)' == ''">$(APPDATA)\Vintagestory</VintageStoryPath>
    <VintageStoryDataPath Condition="'$(VintageStoryDataPath)' == '' and '$(VINTAGE_STORY_DATA)' != ''">$(VINTAGE_STORY_DATA)</VintageStoryDataPath>
  </PropertyGroup>
</Project>
