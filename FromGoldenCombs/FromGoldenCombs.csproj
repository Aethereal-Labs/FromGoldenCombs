<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <AssemblyName>FromGoldenCombs</AssemblyName>
    <RootNamespace>FromGoldenCombs</RootNamespace>
    <!-- Output is laid out as a mod folder: bin\<Config>\Mods\fromgoldencombs\{FromGoldenCombs.dll, modinfo.json, assets\...} -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>bin\$(Configuration)\Mods\fromgoldencombs\</OutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>portable</DebugType>
    <ModOutputPath>$(MSBuildProjectDirectory)\bin\$(Configuration)\Mods</ModOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <!-- Game assemblies. Paths come from Directory.Build.props / Directory.Build.props.user. -->
  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VintageStoryPath)\VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VintagestoryLib">
      <HintPath>$(VintageStoryPath)\VintagestoryLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSSurvivalMod">
      <HintPath>$(VintageStoryPath)\Mods\VSSurvivalMod.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSEssentials">
      <HintPath>$(VintageStoryPath)\Mods\VSEssentials.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(VintageStoryPath)\Lib\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(VintageStoryPath)\Lib\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="protobuf-net">
      <HintPath>$(VintageStoryPath)\Lib\protobuf-net.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Mod content copied next to the DLL -->
  <ItemGroup>
    <Compile Remove="bin\**;obj\**;assets\**" />
    <None Remove="bin\**;obj\**;assets\**" />
    <None Remove="modinfo.json;modicon.png;changelog.txt" />
    <None Remove="Properties\launchSettings.template.json" />

    <Content Include="assets\**" Exclude="assets\wildcrafttree\**;assets\fromgoldencombs\blocktypes\plushyblock.json;assets\fromgoldencombs\shapes\block\sittingdrifter.json;assets\fromgoldencombs\shapes\block\tinydave.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="modinfo.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="modicon.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="changelog.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Generate Properties\launchSettings.json (gitignored) from the template using the machine-specific
    paths, so IDE launch profiles start the game with the configured test data path.
    Skipped when no data path is configured, so nothing ever points at a real game data folder.
  -->
  <Target Name="GenerateLaunchSettings" BeforeTargets="BeforeBuild" Condition="'$(VintageStoryDataPath)' != ''">
    <PropertyGroup>
      <_LaunchTemplate>$(MSBuildProjectDirectory)\Properties\launchSettings.template.json</_LaunchTemplate>
      <_LaunchTarget>$(MSBuildProjectDirectory)\Properties\launchSettings.json</_LaunchTarget>
      <_LaunchContent>$([System.IO.File]::ReadAllText('$(_LaunchTemplate)').Replace('{VintageStoryPath}', '$(VintageStoryPath.Replace('\', '\\'))').Replace('{VintageStoryDataPath}', '$(VintageStoryDataPath.Replace('\', '\\'))').Replace('{ModOutputPath}', '$(ModOutputPath.Replace('\', '\\'))'))</_LaunchContent>
      <_LaunchExisting Condition="Exists('$(_LaunchTarget)')">$([System.IO.File]::ReadAllText('$(_LaunchTarget)'))</_LaunchExisting>
    </PropertyGroup>
    <WriteLinesToFile File="$(_LaunchTarget)" Lines="$(_LaunchContent)" Overwrite="true" Condition="'$(_LaunchContent)' != '$(_LaunchExisting)'" />
  </Target>

</Project>
